      "apply": { "model": "sparkle-craft:block/large_mana_tank_north_west", "y": 270, "uvlock": true }
    },
    {
      "when": { "facing": "north", "part": "forward", "half": "lower" },
      "apply": { "model": "sparkle-craft:block/large_mana_tank_north_east", "y": 270, "uvlock": true }
