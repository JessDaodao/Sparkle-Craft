      "apply": { "model": "sparkle-craft:block/large_mana_tank_south_west", "y": 270, "uvlock": true }
    },
    {
      "when": { "facing": "north", "part": "diagonal", "half": "lower" },
      "apply": { "model": "sparkle-craft:block/large_mana_tank_south_east", "y": 270, "uvlock": true }
    },
