{
  "multipart": [
    {
      "when": { "facing": "east", "part": "controller", "half": "lower" },
      "apply": { "model": "sparkle-craft:block/large_mana_tank_north_west" }
    },
    {
      "when": { "facing": "east", "part": "forward", "half": "lower" },
      "apply": { "model": "sparkle-craft:block/large_mana_tank_north_east" }
    },
    {
      "when": { "facing": "east", "part": "right", "half": "lower" },
      "apply": { "model": "sparkle-craft:block/large_mana_tank_south_west" }
    },
    {
      "when": { "facing": "east", "part": "diagonal", "half": "lower" },
      "apply": { "model": "sparkle-craft:block/large_mana_tank_south_east" }
    },
    {
      "when": { "facing": "east", "part": "controller", "half": "upper" },
      "apply": { "model": "sparkle-craft:block/large_mana_tank_upper_north_west" }
